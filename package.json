{
  "name": "vetsync",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "db:migrate": "npm run db:migrate --workspace @vetsync/api",
    "db:generate": "npm run db:generate --workspace @vetsync/api",
    "test": "npm run test --workspace @vetsync/api"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
